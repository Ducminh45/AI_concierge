# App Settings
RC_ENVIRONMENT=dev
RC_LOG_LEVEL=info

# Resort Configuration
RC_RESORT_NAME="Vietnam Luxury Resorts"
RC_DEFAULT_LANGUAGE=vi
RC_RESORT_TIMEZONE=Asia/Ho_Chi_Minh

# LLM Provider Keys (at least one required)
RC_OPENAI_API_KEY=''
RC_ANTHROPIC_API_KEY=your-anthropic-key-here
RC_OPENROUTER_API_KEY=
RC_OPENROUTER_ENABLED=false
RC_OLLAMA_ENABLED=false

# LLM Configuration
RC_LLM_PROVIDER_PRIORITY=openai,anthropic,openrouter,ollama
RC_LLM_FALLBACK_ENABLED=true
RC_OPENAI_MODEL=gpt-4o-mini
RC_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# API Security
RC_API_KEY=your-api-key-here-must-be-32-chars-for-prod
RC_JWT_SECRET=your-jwt-secret-here-must-be-32-chars-for-prod
RC_RAG_INGESTION_TOKEN=your-rag-ingestion-token-here

# Hallucination Detection
RC_HALLUCINATION_HIGH_THRESHOLD=0.7
RC_HALLUCINATION_MEDIUM_THRESHOLD=0.4

# Database (SQLite default; use postgresql:// for Postgres)
RC_DATABASE_URL=sqlite:///./resort_concierge.db
# RC_DATABASE_URL=postgresql://resort:${POSTGRES_PASSWORD}@db:5432/resort_concierge
POSTGRES_PASSWORD=change-me-in-production
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# Redis Caching (disabled by default)
RC_REDIS_URL=redis://redis:6379/0
RC_REDIS_ENABLED=false

# Optional Features
RC_ENABLE_GRADIO=false
RC_MLFLOW_ENABLED=false
RC_TAVILY_API_KEY=